<?php

declare(strict_types=1);

namespace App\Http\Requests;

use Illuminate\Foundation\Http\FormRequest;

final class DecideVerdictApprovalRequest extends FormRequest
{
    public function authorize(): bool
    {
        // This gate answers only "is an authenticated reviewer present"; per-receipt authorization
        // (does this receipt belong to a conversation this reviewer may decide) runs inside
        // ApprovalManager::approve()/reject() via the configured App\Support\VerdictApprovalAuthorizer.
        return $this->user() !== null;
    }

    /** @return array<string, list<string>> */
    public function rules(): array
    {
        return [
            'receipt_id' => ['required', 'string', 'max:255'],
            'tool_call_id' => ['required', 'string', 'max:255'],
        ];
    }
}
